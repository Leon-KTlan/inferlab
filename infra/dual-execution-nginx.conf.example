# EXAMPLE ONLY; substitute local API upstream and deployment-specific Worker CIDR.
# In http {}:
limit_req_zone $binary_remote_addr zone=runner_claim:1m rate=5r/m;
limit_req_zone $binary_remote_addr zone=runner_lease:1m rate=20r/s;

# In the existing public HTTPS server {}; keep existing runner-tasks/internal denies:
location = /api/v1/runner-claims {
    limit_except POST { deny all; }
    limit_req zone=runner_claim burst=5 nodelay;
    client_max_body_size 16k;
    access_log off;
    proxy_set_header Host $host;
    proxy_pass http://127.0.0.1:8080;
}
location ~ ^/api/v1/execution-leases/run_[A-Za-z0-9_-]+/(control|result)$ {
    limit_except GET POST { deny all; }
    limit_req zone=runner_lease burst=10 nodelay;
    client_max_body_size 16k;
    access_log off;
    proxy_set_header Host $host;
    proxy_pass http://127.0.0.1:8080;
}

